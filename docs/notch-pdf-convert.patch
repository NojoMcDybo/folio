+/// Folio suchen: `FOLIO_EXE`, die Installation im Benutzerordner (NSIS currentUser), Programme.
+fn find_folio() -> Option<PathBuf> {
+    let mut c: Vec<PathBuf> = Vec::new();
+    if let Some(p) = std::env::var_os("FOLIO_EXE") {
+        c.push(PathBuf::from(p));
+    }
+    if let Some(l) = std::env::var_os("LOCALAPPDATA") {
+        let l = PathBuf::from(l);
+        c.push(l.join("Folio").join("folio.exe"));
+        c.push(l.join("Programs").join("Folio").join("folio.exe"));
+    }
+    if let Some(p) = std::env::var_os("ProgramFiles") {
+        c.push(PathBuf::from(p).join("Folio").join("folio.exe"));
+    }
+    c.into_iter().find(|p| p.is_file())
+}
+
+static FOLIO_CACHE: Mutex<Option<PathBuf>> = Mutex::new(None);
+fn folio() -> Option<PathBuf> {
+    let mut c = FOLIO_CACHE.lock().unwrap();
+    if c.is_none() {
+        *c = find_folio();
+    }
+    c.clone()
+}
+
+/// Folio ohne Fenster aufrufen. Es schreibt nach `out` (nie ueber eine vorhandene Datei) und
+/// meldet auf stdout JSON mit `before`/`after`; Rueckgabe ist die kurze Statuszeile.
+fn folio_convert(src: &Path, target: &str, out: &Path) -> Result<String, String> {
+    let exe = folio().ok_or("Folio fehlt")?;
+    let mut c = Command::new(exe);
+    match target {
+        "pdf-mail" => c.args(["--compress"]).arg(src).args(["--preset", "mail"]),
+        "pdf-screen" => c.args(["--compress"]).arg(src).args(["--preset", "screen"]),
+        "pdf-gray" => c.args(["--gray"]).arg(src),
+        _ => return Err("unbekanntes Ziel".into()),
+    };
+    let o = c.arg("--out").arg(out).creation_flags(CREATE_NO_WINDOW).output().map_err(|e| e.to_string())?;
+    if !o.status.success() {
+        let _ = std::fs::remove_file(out);
+        return Err(String::from_utf8_lossy(&o.stderr).lines().next().unwrap_or("Folio-Fehler").to_string());
+    }
+    let report: serde_json::Value = serde_json::from_slice(&o.stdout).unwrap_or_default();
+    let mb = |k: &str| report[k].as_f64().map(|b| b / 1_048_576.0);
+    Ok(match (mb("before"), mb("after")) {
+        (Some(a), Some(b)) => format!("fertig · {a:.1} MB → {b:.1} MB"),
+        _ => "fertig".to_string(),
+    })
+}
